<!DOCTYPE html>
<html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Adeleke - Supply Chain Live Dashboard | Grafana Dark, interactive drill-down, component tracking ISB-200 PCX-450 ECU-900 | Portfolio Project">
<title>Adeleke - Supply Chain Live Dashboard - Portfolio</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
body{background:#0b0e14;color:#dfe6e9;font-family:Inter,Segoe UI,Arial;margin:0;padding:16px}
.header{background:#1c1f2b;border:1px solid #2d3344;padding:14px 20px;border-radius:8px;display:flex;justify-content:space-between;align-items:center}
.grid6{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin:16px 0}
.card{background:#1c1f2b;border:1px solid #2d3344;border-left:4px solid #0984e3;padding:14px;border-radius:6px;cursor:pointer;transition:all 0.2s}
.card:hover{border-color:#0984e3;transform:translateY(-3px);box-shadow:0 6px 20px rgba(9,132,227,0.3)}
.card.red{border-left-color:#e74c3c}.card.orange{border-left-color:#f39c12}.card.green{border-left-color:#27ae60}.card.purple{border-left-color:#6c5ce7}
.card.active{border:2px solid #0984e3;background:#232838;box-shadow:0 0 0 3px rgba(9,132,227,0.2)}
.label{font-size:10px;color:#636e72;text-transform:uppercase;letter-spacing:1px}.value{font-size:22px;font-weight:bold;margin:6px 0}.sub{font-size:11px;color:#b2bec3}
.grid2{display:grid;grid-template-columns:2fr 1fr;gap:12px}
.panel{background:#1c1f2b;border:1px solid #2d3344;border-radius:6px;padding:16px;margin-bottom:12px}
.panel-title{font-size:11px;color:#636e72;text-transform:uppercase;text-align:center;margin-bottom:12px}
.detail-panel{display:none;background:#1e2336;border:2px solid #0984e3;border-radius:8px;padding:20px;margin:16px 0}
.detail-panel.show{display:block}
.detail-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
.metric-big{font-size:32px;font-weight:bold;color:#0984e3}.metric-label{font-size:11px;color:#636e72;text-transform:uppercase}
.footer{text-align:right;font-size:11px;color:#636e72;border-top:1px solid #2d3344;padding-top:12px;margin-top:20px}
a{color:#b2bec3;text-decoration:none}
table{width:100%;border-collapse:collapse;font-size:11px}
th{color:#636e72;text-align:left;padding:6px;border-bottom:1px solid #2d3344}
td{padding:6px;border-bottom:1px solid #1e2330}
.badge{padding:2px 8px;border-radius:10px;font-size:9px;color:white}
.badge-red{background:#e74c3c}.badge-green{background:#27ae60}.badge-orange{background:#f39c12}
.close-btn{background:#2d3344;color:#dfe6e9;border:1px solid #3d445c;padding:6px 12px;border-radius:4px;cursor:pointer;font-size:11px;float:right}
#riskTable tbody tr:hover{background:#232838 !important}
.form-input{background:#0b0e14;border:1px solid #2d3344;color:#dfe6e9;padding:8px;border-radius:4px;width:100%;font-size:12px;margin:6px 0}
.form-label{font-size:10px;color:#636e72;text-transform:uppercase;margin-top:8px;display:block}
</style>
</head><body>
<div class="header">
<div>
<div style="font-size:20px;font-weight:bold">📦 Adeleke — Supply Chain Live Dashboard</div>
<div style="font-size:11px;color:#636e72">Agentic AI • Live metrics • Grafana Dark • Portfolio Project • Built by Adeleke</div>
</div>
<div style="display:flex;gap:8px;align-items:center">
<div style="font-size:11px;color:#b2bec3">Adeleke's Portfolio</div>
<a href="https://github.com/adeleke-analytics" style="border:1px solid #0984e3;color:#0984e3;padding:6px 14px;border-radius:4px;font-size:11px">View Projects →</a>
</div>
</div>

<div id="kpis" class="grid6"></div>

<div id="detailPanel" class="detail-panel">
<button class="close-btn" onclick="closeDetail()">✕ Close</button>
<div id="detailTitle" style="font-size:16px;font-weight:bold;margin-bottom:16px"></div>
<div id="detailContent"></div>
</div>

<div class="grid2">
<div>
<div class="panel"><div class="panel-title">Hourly Delay by Supplier - Stacked Bar</div><canvas id="hourly" height="130"></canvas></div>
<div class="panel"><div class="panel-title">Cost vs Delay Scatter - Supplier Performance Tradeoff</div><canvas id="scatter" height="110"></canvas><div style="font-size:9px;color:#636e72;text-align:center">X=Avg Delay, Y=Avg Cost, Size=Shipment volume</div></div>
</div>
<div>
<div class="panel"><div class="panel-title">Wastage by Component - Correct Pie Usage</div><div style="font-size:9px;color:#636e72;text-align:center;margin-bottom:6px">Pie = part-of-whole, shows % of total shortage by component</div><canvas id="pie" height="170"></canvas></div>
<div class="panel"><div class="panel-title">Last 7 Days Delay Trend</div><canvas id="trend" height="110"></canvas></div>
</div>
</div>

<div class="grid2">
<div class="panel"><div class="panel-title">Cost by Destination - Variance</div><canvas id="costDest" height="130"></canvas></div>
<div class="panel"><div class="panel-title">Ordered vs Delivered by Component - Wastage (Grouped Bar)</div><canvas id="od" height="130"></canvas></div>
</div>

<div class="panel"><div class="panel-title">Top 15 Riskiest Shipments - Click row for full details & actions</div><table id="riskTable"><thead><tr><th>Shipment</th><th>Supplier</th><th>Component</th><th>Delay</th><th>Cost</th><th>Status</th></tr></thead><tbody></tbody></table></div>

<div id="shipmentModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:1000;justify-content:center;align-items:center">
<div style="background:#1c1f2b;border:2px solid #2d3344;border-radius:8px;padding:24px;width:90%;max-width:650px;max-height:85vh;overflow-y:auto">
<div id="shipmentTitle" style="font-size:16px;font-weight:bold;margin-bottom:16px"></div>
<div id="shipmentContent"></div>
</div>
</div>

<div id="expediteModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:1100;justify-content:center;align-items:center">
<div style="background:#1e2336;border:2px solid #0984e3;border-radius:8px;padding:24px;width:90%;max-width:500px">
<div style="font-size:16px;font-weight:bold;margin-bottom:12px">⚡ Expedite Shipment</div>
<div id="expediteContent"></div>
</div>
</div>

<div id="contactModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:1100;justify-content:center;align-items:center">
<div style="background:#1e2336;border:2px solid #27ae60;border-radius:8px;padding:24px;width:90%;max-width:500px">
<div style="font-size:16px;font-weight:bold;margin-bottom:12px">📧 Contact Supplier</div>
<div id="contactContent"></div>
</div>
</div>

<style>#shipmentModal.show,#expediteModal.show,#contactModal.show{display:flex !important}</style>

<div class="footer">Built by Adeleke • Chart.js • Grafana Dark • Live: https://adeleke-analytics.github.io/supply-chain-live-adeleke/ • Professional Portfolio</div>

<script>
const suppliers = [
  {id:'APEX_IND', name:'Apex Industrial Logistics', short:'Apex Industrial', color:'#0984e3', contact:'ops@apexindustrial-logistics.com', manager:'James Okonkwo'},
  {id:'NSTAR_FREIGHT', name:'NorthStar Freight Systems', short:'NorthStar Freight', color:'#74b9ff', contact:'support@northstar-freight.com', manager:'Sarah Mensah'},
  {id:'HORIZON_SUP', name:'Horizon Supply Co.', short:'Horizon Supply', color:'#ff7675', contact:'dispatch@horizonsupply.co', manager:'David Adeyemi'},
  {id:'VERTEX_GLB', name:'Vertex Global Transport', short:'Vertex Global', color:'#fab1a0', contact:'logistics@vertexglobal-transport.com', manager:'Chloe Williams'}
]
const components = [
  {code:'ISB-200', name:'Industrial Steel Beams', category:'Structural', unit:'tons'},
  {code:'PCX-450', name:'Precision Components', category:'Mechanical', unit:'units'},
  {code:'ECU-900', name:'Electronic Control Units', category:'Electronics', unit:'pcs'},
  {code:'RPM-150', name:'Raw Polymer Materials', category:'Raw Material', unit:'kg'}
]
let selectedSupplier=null
let allData=[]
for(let i=0;i<500;i++){
  const sup = suppliers[Math.floor(Math.random()*4)]
  const comp = components[Math.floor(Math.random()*4)]
  allData.push({
    id:'SHP-'+(2024+i),
    supplierId:sup.id,
    supplier:sup.short,
    supplierFull:sup.name,
    supplierContact:sup.contact,
    supplierManager:sup.manager,
    delay:Math.floor(Math.random()*10),
    cost:2500+Math.random()*6500,
    productCode:comp.code,
    product:comp.name,
    productCategory:comp.category,
    dest:['Houston, TX','Austin, TX','Princeton, TX','Dallas, TX'][Math.floor(Math.random()*4)],
    on_time:Math.random()>0.4,
    in_full:Math.random()>0.48,
    ordered:100,
    delivered:80+Math.floor(Math.random()*20)
  })
}

function renderKPIs(){
  const total=allData.length, otif=allData.filter(d=>d.on_time&&d.in_full).length, delayed2=allData.filter(d=>d.delay>2).length
  const apexData = allData.filter(d=>d.supplierId==='APEX_IND')
  const kpis=[
    {label:'Apex Industrial Risk',value:(apexData.reduce((a,b)=>a+b.delay,0)/apexData.length).toFixed(1)+'d',sub:apexData.filter(d=>d.delay>2).length+' delayed • Highest risk',cls:'red',key:'APEX_IND',desc:'Apex Industrial Logistics'},
    {label:'Avg Shipping Cost',value:'$5,348',sub:'500 shipments • Click breakdown',cls:'orange',key:'COST',desc:'Cost analysis'},
    {label:'OTIF %',value:Math.round(otif/total*100)+'%',sub:otif+'/'+total+' OTIF • Target 95%',cls:'green',key:'OTIF',desc:'On Time In Full'},
    {label:'On-Time Delivery',value:'60%',sub:'300 on-time • Click trend',cls:'green',key:'ONTIME',desc:'On-time delivery rate'},
    {label:'In-Full Delivery',value:'52%',sub:'Wastage 8.2% • Click components',cls:'green',key:'INFULL',desc:'In-full delivery'},
    {label:'At Risk Shipments',value:delayed2,sub:'Delayed >2d • Click list',cls:'purple',key:'RISK',desc:'At risk shipments'}
  ]
  document.getElementById('kpis').innerHTML=kpis.map(k=>'<div class="card '+k.cls+' '+(selectedSupplier===k.key?'active':'')+'" onclick="handleCardClick(\''+k.key+'\',\''+k.label+'\')"><div class="label">'+k.label+'</div><div class="value" style="color:'+(k.cls==='red'?'#e74c3c':k.cls==='orange'?'#f39c12':k.cls==='green'?'#27ae60':'#6c5ce7')+'">'+k.value+'</div><div class="sub">'+k.sub+'</div><div style="font-size:9px;color:#0984e3;margin-top:8px;background:#0f1c2e;padding:3px 6px;border-radius:4px;display:inline-block">'+(selectedSupplier===k.key?'✓ Showing details below':'Click to reveal details →')+'</div></div>').join('')
}

function handleCardClick(key,label){
  selectedSupplier = selectedSupplier===key ? null : key
  renderKPIs()
  if(!selectedSupplier){closeDetail(); renderTable(); return}
  const panel=document.getElementById('detailPanel')
  document.getElementById('detailTitle').innerHTML='📊 '+label+' - Detailed Analysis'
  let content=''
  let filtered = ['APEX_IND','NSTAR_FREIGHT','HORIZON_SUP','VERTEX_GLB'].includes(key) ? allData.filter(d=>d.supplierId===key) : allData
  if(key==='APEX_IND'){
    const avgDelay=(filtered.reduce((a,b)=>a+b.delay,0)/filtered.length).toFixed(2)
    const avgCost=(filtered.reduce((a,b)=>a+b.cost,0)/filtered.length).toFixed(0)
    content='<div class="detail-grid"><div><div class="metric-label">Total Shipments</div><div class="metric-big">'+filtered.length+'</div></div><div><div class="metric-label">Avg Delay</div><div class="metric-big" style="color:#e74c3c">'+avgDelay+'d</div></div><div><div class="metric-label">Avg Cost</div><div class="metric-big" style="color:#f39c12">$'+avgCost+'</div></div></div><div style="margin-top:16px;padding:12px;background:#1c1f2b;border-radius:6px;font-size:11px"><b>Supplier:</b> Apex Industrial Logistics - Contact: James Okonkwo<br><b>Root Cause:</b> Houston route congestion, PCX-450 handling delays<br><b>Recommendation:</b> Switch 30% to NorthStar Freight</div>'
  } else if(key==='OTIF'){
    const otif=allData.filter(d=>d.on_time&&d.in_full).length
    content='<div class="detail-grid"><div><div class="metric-label">OTIF</div><div class="metric-big" style="color:#e74c3c">'+Math.round(otif/allData.length*100)+'%</div></div><div><div class="metric-label">On-Time</div><div class="metric-big">60%</div></div><div><div class="metric-label">In-Full</div><div class="metric-big">52%</div></div></div>'
  } else if(key==='COST'){
    content='<div class="detail-grid"><div><div class="metric-label">Avg Cost</div><div class="metric-big" style="color:#f39c12">$5,348</div></div><div><div class="metric-label">Total Spend</div><div class="metric-big">$2.67M</div></div></div>'
  } else {
    const delayed=allData.filter(d=>d.delay>2)
    content='<div class="detail-grid"><div><div class="metric-label">Delayed >2d</div><div class="metric-big" style="color:#e74c3c">'+delayed.length+'</div></div></div>'
  }
  document.getElementById('detailContent').innerHTML=content
  panel.classList.add('show')
  panel.scrollIntoView({behavior:'smooth'})
  renderTable()
}
function closeDetail(){document.getElementById('detailPanel').classList.remove('show'); selectedSupplier=null; renderKPIs(); renderTable()}
function renderTable(){
  let filtered = selectedSupplier && ['APEX_IND','NSTAR_FREIGHT','HORIZON_SUP','VERTEX_GLB'].includes(selectedSupplier) ? allData.filter(d=>d.supplierId===selectedSupplier) : selectedSupplier==='RISK' ? allData.filter(d=>d.delay>2) : allData
  const top=filtered.sort((a,b)=>b.delay-a.delay).slice(0,15)
  document.querySelector('#riskTable tbody').innerHTML=top.map(r=>'<tr onclick="showShipmentDetail(\''+r.id+'\')" style="cursor:pointer"><td><span style="color:#0984e3;text-decoration:underline;font-weight:bold">'+r.id+'</span></td><td>'+r.supplier+'<div style="font-size:8px;color:#636e72">'+r.supplierId+'</div></td><td><b>'+r.productCode+'</b><div style="font-size:8px;color:#b2bec3">'+r.product+'</div></td><td style="color:'+(r.delay>5?'#e74c3c':r.delay>2?'#f39c12':'#27ae60')+'"><b>'+r.delay+'d</b></td><td>$'+Math.round(r.cost)+'</td><td><span class="badge '+(r.delay>2?'badge-red':r.delay>0?'badge-orange':'badge-green')+'">'+(r.delay>2?'Delayed':r.delay>0?'Slight':'On Time')+'</span></td></tr>').join('')
}
function showShipmentDetail(shipId){
  const ship = allData.find(d=>d.id===shipId)
  const modal=document.getElementById('shipmentModal')
  document.getElementById('shipmentTitle').innerHTML='📦 '+ship.id+' - '+ship.productCode+' - '+ship.supplier
  document.getElementById('shipmentContent').innerHTML='<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px"><div><div class="metric-label">Supplier</div><div style="font-size:13px;font-weight:bold">'+ship.supplierFull+'</div><div style="font-size:10px;color:#636e72">'+ship.supplierId+' • '+ship.supplierManager+'</div></div><div><div class="metric-label">Component</div><div style="font-size:13px;font-weight:bold"><b>'+ship.productCode+'</b> - '+ship.product+'</div></div><div><div class="metric-label">Destination</div><div style="font-size:13px;font-weight:bold">'+ship.dest+'</div></div><div><div class="metric-label">Status</div><div><span class="badge '+(ship.delay>2?'badge-red':'badge-green')+'">'+(ship.delay>2?'Delayed - '+ship.delay+'d':'On Time')+'</span></div></div><div><div class="metric-label">Delay</div><div style="font-size:24px;font-weight:bold;color:'+(ship.delay>5?'#e74c3c':'#f39c12')+'">'+ship.delay+' days</div></div><div><div class="metric-label">Shipping Cost</div><div style="font-size:20px;font-weight:bold">$'+Math.round(ship.cost)+'</div></div></div><div style="display:flex;gap:8px"><button style="background:#0984e3;color:white;border:none;padding:10px 18px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:bold" onclick="openExpediteModal(\''+ship.id+'\')">⚡ Expedite Shipment</button><button style="background:#27ae60;color:white;border:none;padding:10px 18px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:bold" onclick="openContactModal(\''+ship.id+'\')">📧 Contact Supplier</button><button style="background:transparent;color:#636e72;border:1px solid #2d3344;padding:10px 16px;border-radius:4px;cursor:pointer;font-size:11px" onclick="closeShipmentModal()">Close</button></div>'
  modal.classList.add('show')
}
function closeShipmentModal(){document.getElementById('shipmentModal').classList.remove('show')}
function openExpediteModal(shipId){
  const ship=allData.find(d=>d.id===shipId)
  document.getElementById('expediteContent').innerHTML='<div style="font-size:11px;color:#b2bec3;margin-bottom:12px">Shipment: <b>'+ship.id+'</b> • '+ship.supplierFull+' • '+ship.productCode+'<br>Current delay: <b style="color:#e74c3c">'+ship.delay+' days</b></div><label class="form-label">Expedite Method</label><select class="form-input" id="expMethod"><option>Air Freight - $1,200 extra - 1 day</option><option>Express Road - $450 extra - 2 days</option><option>Priority Handling - $200 extra - Same day dispatch</option></select><label class="form-label">Reason</label><textarea class="form-input" rows="3">Critical component '+ship.productCode+' needed urgently.</textarea><div style="margin-top:16px;display:flex;gap:8px"><button style="background:#0984e3;color:white;border:none;padding:10px 18px;border-radius:4px;cursor:pointer;font-size:11px" onclick="submitExpedite(\''+ship.id+'\')">Confirm Expedite - $450</button><button style="background:transparent;color:#636e72;border:1px solid #2d3344;padding:10px 16px;border-radius:4px;cursor:pointer;font-size:11px" onclick="closeExpediteModal()">Cancel</button></div><div id="expediteResult" style="margin-top:12px;font-size:11px"></div>'
  document.getElementById('expediteModal').classList.add('show')
}
function submitExpedite(shipId){
  const method=document.getElementById('expMethod').value
  document.getElementById('expediteResult').innerHTML='<div style="background:#1a2a1a;border:1px solid #27ae60;padding:10px;border-radius:4px;color:#27ae60">✅ Expedite request submitted for '+shipId+'<br>Method: '+method+'<br>Tracking: EXP-'+Date.now().toString().slice(-6)+'</div>'
  setTimeout(()=>{closeExpediteModal(); closeShipmentModal();},2500)
}
function closeExpediteModal(){document.getElementById('expediteModal').classList.remove('show')}
function openContactModal(shipId){
  const ship=allData.find(d=>d.id===shipId)
  document.getElementById('contactContent').innerHTML='<div style="font-size:11px;color:#b2bec3;margin-bottom:12px">To: <b>'+ship.supplierManager+'</b> ('+ship.supplierFull+')<br>Email: '+ship.supplierContact+'</div><label class="form-label">Subject</label><input class="form-input" value="Urgent: Shipment '+ship.id+' - '+ship.productCode+' delayed '+ship.delay+' days" /><label class="form-label">Message</label><textarea class="form-input" rows="4">Hello '+ship.supplierManager+',\n\nShipment '+ship.id+' containing '+ship.productCode+' for '+ship.dest+' is delayed '+ship.delay+' days.\n\nRegards,\nAdeleke</textarea><div style="margin-top:16px;display:flex;gap:8px"><button style="background:#27ae60;color:white;border:none;padding:10px 18px;border-radius:4px;cursor:pointer;font-size:11px" onclick="submitContact(\''+ship.id+'\')">Send Email to '+ship.supplier+'</button><button style="background:transparent;color:#636e72;border:1px solid #2d3344;padding:10px 16px;border-radius:4px;cursor:pointer;font-size:11px" onclick="closeContactModal()">Cancel</button></div><div id="contactResult" style="margin-top:12px;font-size:11px"></div>'
  document.getElementById('contactModal').classList.add('show')
}
function submitContact(shipId){
  const ship=allData.find(d=>d.id===shipId)
  document.getElementById('contactResult').innerHTML='<div style="background:#1a2a1a;border:1px solid #27ae60;padding:10px;border-radius:4px;color:#27ae60">✅ Email sent to '+ship.supplierManager+' at '+ship.supplierContact+'<br>Ticket: TKT-'+Date.now().toString().slice(-6)+' opened.</div>'
  setTimeout(()=>{closeContactModal(); closeShipmentModal();},2500)
}
function closeContactModal(){document.getElementById('contactModal').classList.remove('show')}
renderKPIs(); renderTable()
new Chart(document.getElementById('hourly'),{type:'bar',data:{labels:['00:00','02:00','04:00','06:00','08:00'],datasets:[{label:'Apex Industrial',data:[20,25,18,30,45],backgroundColor:'#0984e3',stack:'s'},{label:'NorthStar',data:[15,18,20,22,35],backgroundColor:'#74b9ff',stack:'s'},{label:'Horizon',data:[10,12,15,18,28],backgroundColor:'#ff7675',stack:'s'},{label:'Vertex',data:[8,10,12,15,20],backgroundColor:'#fab1a0',stack:'s'}]},options:{responsive:true,plugins:{legend:{labels:{color:'#636e72',font:{size:10}}}},scales:{x:{stacked:true,ticks:{color:'#636e72'}},y:{stacked:true,ticks:{color:'#636e72'}}}}})
new Chart(document.getElementById('pie'),{type:'doughnut',data:{labels:['PCX-450 Precision','ECU-900 Electronics','RPM-150 Polymer','ISB-200 Steel'],datasets:[{data:[30,28,25,17],backgroundColor:['#0984e3','#00b894','#fdcb6e','#e17055']}]},options:{plugins:{legend:{position:'right',labels:{color:'#b2bec3',font:{size:9}}}}}})
new Chart(document.getElementById('trend'),{type:'bar',data:{labels:['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],datasets:[{data:[12,18,8,22,35,30,11],backgroundColor:'#00b894'}]},options:{plugins:{legend:{display:false}},scales:{x:{ticks:{color:'#636e72'}},y:{ticks:{color:'#636e72'}}}}})
